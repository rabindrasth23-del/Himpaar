# ---- Database ----
# Local Docker Postgres, or a free Neon connection string if no Docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/himpaar

# ---- Server ----
PORT=4000
NODE_ENV=development
APP_MODE=test
BACKEND_PUBLIC_URL=https://your-ngrok-id.ngrok-free.app
WEB_URL=http://localhost:5173

# ---- Sessions / CSRF (your own auth, not Supabase) ----
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_random_64_char_hex_string

# ---- eSewa sandbox ----
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=replace_with_esewa_sandbox_secret

# ---- Khalti sandbox ----
# Get this from your own Khalti sandbox merchant account
KHALTI_SECRET_KEY=replace_with_your_khalti_test_secret_key
