# ---- Database ----
# Local Docker Postgres, or a free Neon connection string if no Docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/himpaar

# ---- Server ----
PORT=4000
NODE_ENV=development
SANDBOX_MODE=true
SIMULATOR_WEBHOOK_SECRET=whsec_change-me-to-a-random-base64-string
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
LOG_LEVEL=debug

# ---- Sessions / CSRF ----
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_random_64_char_hex_string

# ---- Nepal rules (simulated / unverified) ----
UNVERIFIED_DEMO_FX_NPR_PER_USD_MICRO=134250000
UNVERIFIED_DEMO_FEE_BPS=100
