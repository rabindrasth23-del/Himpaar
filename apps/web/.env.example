# ---- Frontend ----
# Base URL of the API. Empty means same origin (production) or the Vite dev proxy.
VITE_API_URL=
# "mock" uses in-memory sample data; "real" calls the API at VITE_API_URL.
VITE_API_MODE=mock
# Sandbox UI (simulate buttons, sandbox controls). The MVP is sandbox only.
VITE_SANDBOX_MODE=true
